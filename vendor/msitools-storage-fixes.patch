+typedef struct {
+    LibmsiDatabase *db;
+    const LibmsiTable *t;
+} row_sort_ctx;
+
+/* Windows Installer expects the rows of every table to be stored ordered by the primary key
+   (string columns by string id, integer columns by their stored value). libmsi keeps rows
+   in insertion order, so rows added to an existing table end up unsorted and Windows Installer
+   then fails with error 2211 ("Could not create database table"). */
+static int compare_rows_by_key( gconstpointer pa, gconstpointer pb, gpointer opaque )
+{
+    const row_sort_ctx *ctx = opaque;
+    const LibmsiTable *t = ctx->t;
+    unsigned a = *(const unsigned *)pa, b = *(const unsigned *)pb, j;
 
+    for (j = 0; j < t->col_count; j++)
+    {
+        unsigned m, va, vb;
+
+        if (!(t->colinfo[j].type & MSITYPE_KEY)) continue;
+        m = bytes_per_column( ctx->db, &t->colinfo[j], LONG_STR_BYTES );
+        va = read_table_int( t->data, a, t->colinfo[j].offset, m );
+        vb = read_table_int( t->data, b, t->colinfo[j].offset, m );
+        if (va != vb) return va < vb ? -1 : 1;
+    }
+    return 0;
+}
