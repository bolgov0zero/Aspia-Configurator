+/* Copy the CLSID of a storage. libgsf does not do it, and Windows Installer refuses to
+   apply an embedded transform whose storage has no transform CLSID (error 1624). */
+static void copy_storage_clsid(GsfInfile *inf, GsfOutput *outf)
+{
+    uint8_t clsid[16];
 
+    if (GSF_IS_INFILE_MSOLE (inf) && GSF_IS_OUTFILE_MSOLE (outf) &&
+        gsf_infile_msole_get_class_id (GSF_INFILE_MSOLE (inf), clsid))
+        gsf_outfile_msole_set_class_id (GSF_OUTFILE_MSOLE (outf), clsid);
+}
